class Solution {
public:
    vector<int> resultArray(vector<int>& nums) {

        vector<int> f;
        vector<int> s;

        f.push_back(nums[0]);
        s.push_back(nums[1]);

        for (int i = 2; i < nums.size(); i++) {

            if (f.back() > s.back()) {
                f.push_back(nums[i]);
            }
            else {
                s.push_back(nums[i]);
            }
        }

        vector<int> res;

        for (int i = 0; i < f.size(); i++) {
            res.push_back(f[i]);
        }

        for (int i = 0; i < s.size(); i++) {
            res.push_back(s[i]);
        }

        return res;
    }
};
